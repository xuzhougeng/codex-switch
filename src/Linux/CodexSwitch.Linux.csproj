<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CodexSwitch.Linux</RootNamespace>
    <AssemblyName>codex-switch</AssemblyName>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/CodexSwitch.Core.csproj" />
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="kernel/linux-x64/mihomo" Link="kernel/linux-x64/mihomo" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" Condition="('$(RuntimeIdentifier)' == 'linux-x64' Or '$(RuntimeIdentifier)' == '') And Exists('kernel/linux-x64/mihomo')" />
    <Content Include="kernel/linux-arm64/mihomo" Link="kernel/linux-arm64/mihomo" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" Condition="('$(RuntimeIdentifier)' == 'linux-arm64' Or '$(RuntimeIdentifier)' == '') And Exists('kernel/linux-arm64/mihomo')" />
    <Content Include="kernel/SOURCE.txt" Link="kernel/SOURCE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="kernel/VERSION" Link="kernel/VERSION" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <EmbeddedResource Include="shell/function.sh" />
  </ItemGroup>
</Project>
