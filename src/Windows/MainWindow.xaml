<Window x:Class="CodexSwitch.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:CodexSwitch.Windows" Title="Codex Switch">
 <Grid x:Name="Root" Background="{ThemeResource CanvasBrush}">

  <VisualStateManager.VisualStateGroups><VisualStateGroup>
   <VisualState x:Name="Compact"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers><VisualState.Setters>
    <Setter Target="RailColumn.Width" Value="76"/><Setter Target="BrandWords.Visibility" Value="Collapsed"/><Setter Target="NavLabel.Visibility" Value="Collapsed"/><Setter Target="ProxyLabel.Visibility" Value="Collapsed"/><Setter Target="HelpLabel.Visibility" Value="Collapsed"/><Setter Target="LocalWords.Visibility" Value="Collapsed"/><Setter Target="RailCaption.Visibility" Value="Collapsed"/>
    <Setter Target="Rail.Padding" Value="14,28,14,22"/><Setter Target="MainPadding.Padding" Value="24,24,24,0"/>
   </VisualState.Setters></VisualState>
   <VisualState x:Name="Wide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="940"/></VisualState.StateTriggers></VisualState>
  </VisualStateGroup></VisualStateManager.VisualStateGroups>
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="RailColumn" Width="196"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Grid x:Name="Rail" Padding="22,30,22,24" Background="{ThemeResource SidebarBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,1,0">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Orientation="Horizontal" Spacing="12">
    <Image Width="44" Height="44" Source="ms-appx:///Assets/app-icon.png" AutomationProperties.Name="Codex Switch"/>
    <StackPanel x:Name="BrandWords" VerticalAlignment="Center"><TextBlock Text="Codex" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Switch" FontSize="13" CharacterSpacing="140" Foreground="{ThemeResource MutedBrush}"/></StackPanel>
   </StackPanel>
   <StackPanel Grid.Row="1" Spacing="8" Margin="0,48,0,0">
    <TextBlock x:Name="RailCaption" Text="工作空间" FontSize="11" Foreground="{ThemeResource MutedBrush}" Margin="10,0,0,10"/>
    <Button x:Name="OverviewButton" Style="{StaticResource QuietButton}" Background="{ThemeResource TintBrush}" Foreground="{ThemeResource BrandBrush}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="Overview_Click" AutomationProperties.Name="账号总览">
     <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE716;" FontSize="17"/><TextBlock x:Name="NavLabel" Text="账号总览" FontWeight="SemiBold"/></StackPanel>
    </Button>
    <Button x:Name="ProxyButton" Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Foreground="{ThemeResource MutedBrush}" Click="Proxy_Click" AutomationProperties.Name="双跳代理">
     <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE774;" FontSize="17"/><TextBlock x:Name="ProxyLabel" Text="双跳代理"/></StackPanel>
    </Button>
    <Button x:Name="HelpButton" Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Foreground="{ThemeResource MutedBrush}" Click="Help_Click" AutomationProperties.Name="使用说明">
     <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE946;" FontSize="17"/><TextBlock x:Name="HelpLabel" Text="使用说明"/></StackPanel>
    </Button>
   </StackPanel>
   <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="10,0,0,0">
    <Ellipse Width="7" Height="7" Fill="{ThemeResource BrandBrush}" VerticalAlignment="Top" Margin="0,5,0,0"/>
    <StackPanel x:Name="LocalWords" Spacing="5"><TextBlock Text="本机存储" FontSize="12"/><TextBlock Text="Codex Switch  /  2.0" FontSize="10" Foreground="{ThemeResource MutedBrush}"/></StackPanel>
   </StackPanel>
  </Grid>
  <Grid Grid.Column="1" x:Name="MainPadding" Padding="36,30,36,0">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,24" ColumnSpacing="12">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Spacing="5"><TextBlock x:Name="PageKicker" Text="ACCOUNTS" FontSize="10" CharacterSpacing="220" Foreground="{ThemeResource MutedBrush}"/><TextBlock x:Name="PageTitle" Text="账号总览" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="PageLede" Text="你的账号，一处管理。" FontSize="12" Foreground="{ThemeResource MutedBrush}"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
     <Button x:Name="RefreshButton" Style="{StaticResource QuietButton}" Click="Refresh_Click" AutomationProperties.Name="刷新账号" ToolTipService.ToolTip="刷新账号"><FontIcon Glyph="&#xE72C;" FontSize="16"/></Button>
     <Button x:Name="LoginButton" Style="{StaticResource PrimaryButton}" Click="Login_Click" AutomationProperties.Name="添加账号"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="13"/><TextBlock Text="添加账号" FontWeight="SemiBold"/></StackPanel></Button>
    </StackPanel>
   </Grid>
   <ScrollViewer x:Name="ActionHost" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" TabFocusNavigation="Local">
    <StackPanel x:Name="Actions" Spacing="28" Padding="0,0,2,24">
     <StackPanel x:Name="AccountsPanel" Spacing="28">
     <Border CornerRadius="16" Background="#193F35" Padding="26,24">
      <Grid>
       <Grid Width="154" Height="154" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,-12,0" IsHitTestVisible="False" Opacity="0.25">
        <Ellipse Width="144" Height="144" Stroke="#7DAE92" StrokeThickness="1"/><Ellipse Width="104" Height="104" Stroke="#7DAE92" StrokeThickness="1"/><Ellipse Width="64" Height="64" Stroke="#7DAE92" StrokeThickness="1"/>
        <Border Width="32" Height="32" CornerRadius="10" Background="#86BCA0"><FontIcon Glyph="&#xE8AB;" FontSize="16" Foreground="#173C31"/></Border>
       </Grid>
       <StackPanel Spacing="18">
        <StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="6" Height="6" Fill="#B7E5C6"/><TextBlock Text="当前账号" FontSize="12" Foreground="#D1E5DA" CharacterSpacing="70"/></StackPanel>
        <StackPanel Spacing="10">
         <TextBlock x:Name="CurrentEmail" Text="正在读取…" Foreground="#FAFFFC" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,30,0"/>
         <Border Background="#31564A" CornerRadius="5" Padding="8,3" HorizontalAlignment="Left"><TextBlock x:Name="CurrentPlan" Foreground="#D8F1E2" FontSize="10" FontWeight="SemiBold" CharacterSpacing="100"/></Border>
        </StackPanel>
        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Button x:Name="SaveButton" Click="Save_Click" Background="#D1EADB" Foreground="#183E32" BorderThickness="0" CornerRadius="7" Padding="12,8" AutomationProperties.Name="保存当前登录"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE74E;" FontSize="13"/><TextBlock Text="保存当前登录" FontSize="12" FontWeight="SemiBold"/></StackPanel></Button>
         <Button Grid.Column="1" Style="{StaticResource QuietButton}" Foreground="#D1E5DA" AutomationProperties.Name="当前账号的更多操作"><FontIcon Glyph="&#xE712;" FontSize="18"/><Button.Flyout><MenuFlyout><MenuFlyoutItem x:Name="ClearButton" Text="清空当前登录…" Click="Clear_Click"/></MenuFlyout></Button.Flyout></Button>
        </Grid>
        <Grid BorderBrush="#3B5A4E" BorderThickness="0,1,0,0" Padding="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBlock Text="额度待核验" Foreground="#B5CFC1" FontSize="11" ToolTipService.ToolTip="本地会话日志不能可靠归属到当前账号，不作为实时额度展示。"/>
         <TextBlock Grid.Column="1" Text="仅在本机保存" Foreground="#B5CFC1" FontSize="11"/>
        </Grid>
       </StackPanel>
      </Grid>
     </Border>
     <StackPanel Spacing="14">
      <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center"><TextBlock Text="账号库" FontSize="17" FontWeight="SemiBold"/><Border Background="{ThemeResource TintBrush}" CornerRadius="5" Padding="7,2"><TextBlock x:Name="CountLabel" Text="0" FontSize="11" Foreground="{ThemeResource BrandBrush}"/></Border></StackPanel>
       <TextBox Grid.Column="1" x:Name="Search" Width="192" PlaceholderText="搜索账号…" TextChanged="Search_Changed" AutomationProperties.Name="搜索邮箱或订阅" FontSize="12" CornerRadius="7" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource LineBrush}"/>
      </Grid>
      <Border CornerRadius="12" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1">
       <StackPanel>
        <StackPanel x:Name="EmptyPanel" Spacing="10" Padding="30"><FontIcon Glyph="&#xE77B;" FontSize="28" Foreground="{ThemeResource MutedBrush}"/><TextBlock x:Name="EmptyLabel" Text="还没有保存的账号" TextAlignment="Center" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource MutedBrush}"/></StackPanel>
        <ItemsControl x:Name="AccountsList"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:AccountRow">
         <Grid Padding="18,16" ColumnSpacing="13" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Width="38" Height="38" CornerRadius="11" Background="{x:Bind AvatarBrush}"><TextBlock Text="{x:Bind Initial}" Foreground="#294B3D" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
           <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{x:Bind Plan}" FontSize="10" FontWeight="SemiBold" CharacterSpacing="60" Foreground="{ThemeResource MutedBrush}"/><TextBlock Text="· 当前使用中" FontSize="10" Foreground="{ThemeResource BrandBrush}" Visibility="{x:Bind CurrentVisibility}"/></StackPanel>
           <TextBlock Text="{x:Bind Email}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Email}"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
           <FontIcon Glyph="&#xE73E;" FontSize="15" Margin="10,0" Foreground="{ThemeResource BrandBrush}" Visibility="{x:Bind CurrentVisibility}" AutomationProperties.Name="当前使用中"/>
           <Button Style="{StaticResource QuietButton}" Tag="{x:Bind Key}" Click="Switch_Click" Visibility="{x:Bind SwitchVisibility}" Foreground="{ThemeResource BrandBrush}" AutomationProperties.Name="{x:Bind SwitchLabel}"><StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Text="切换" FontSize="12"/><FontIcon Glyph="&#xE72A;" FontSize="12"/></StackPanel></Button>
           <Button Style="{StaticResource QuietButton}" AutomationProperties.Name="已保存账号的更多操作"><FontIcon Glyph="&#xE712;" FontSize="16" Foreground="{ThemeResource MutedBrush}"/><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="移除保存的账号…" Tag="{x:Bind Key}" Click="Remove_Click"/></MenuFlyout></Button.Flyout></Button>
          </StackPanel>
         </Grid>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       </StackPanel>
      </Border>
     </StackPanel>
     <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource MutedBrush}"/><TextBlock Text="切换后，重新打开 Codex 以应用新的登录。" FontSize="11" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/></StackPanel>
     </StackPanel>
     <StackPanel x:Name="ProxyPanel" Spacing="16" Visibility="Collapsed">
      <Border CornerRadius="16" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1" Padding="22,20">
       <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Spacing="6">
         <TextBlock Text="状态" FontSize="11" Foreground="{ThemeResource MutedBrush}"/>
         <TextBlock x:Name="ProxyStatus" Text="未运行" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
         <TextBlock Text="Codex 走 http://127.0.0.1:1990。先保存配置再启动。" FontSize="11" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
         <Button x:Name="ProxyStartButton" Style="{StaticResource PrimaryButton}" Click="ProxyStart_Click" AutomationProperties.Name="启动双跳代理"><TextBlock Text="启动" FontWeight="SemiBold"/></Button>
         <Button x:Name="ProxyStopButton" Style="{StaticResource QuietButton}" Click="ProxyStop_Click" AutomationProperties.Name="停止双跳代理"><TextBlock Text="停止"/></Button>
        </StackPanel>
       </Grid>
      </Border>
      <Border CornerRadius="12" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1" Padding="18">
       <StackPanel Spacing="12">
        <TextBlock Text="第一跳 · 中转节点 YAML" FontSize="13" FontWeight="SemiBold"/>
        <TextBox x:Name="ProxyRelayYaml" MinHeight="160" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" PlaceholderText="粘贴中转节点，每条以 - name: 开头"/>
       </StackPanel>
      </Border>
      <Border CornerRadius="12" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1" Padding="18">
       <StackPanel Spacing="12">
        <TextBlock Text="第二跳 · 美国家宽 SOCKS5" FontSize="13" FontWeight="SemiBold"/>
        <Grid ColumnSpacing="10" RowSpacing="10">
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
         <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
         <TextBox x:Name="ProxyHomeServer" PlaceholderText="地址" AutomationProperties.Name="家宽地址"/>
         <TextBox Grid.Column="1" x:Name="ProxyHomePort" PlaceholderText="端口" AutomationProperties.Name="家宽端口"/>
         <TextBox Grid.Row="1" x:Name="ProxyHomeUser" PlaceholderText="用户名（可选）" AutomationProperties.Name="家宽用户名"/>
         <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="ProxyHomePassword" PlaceholderText="密码" AutomationProperties.Name="家宽密码"/>
         <TextBox Grid.Row="2" x:Name="ProxyMaxConcurrent" PlaceholderText="同时最多" AutomationProperties.Name="限流并发"/>
         <TextBox Grid.Row="2" Grid.Column="1" x:Name="ProxyDialInterval" PlaceholderText="间隔毫秒" AutomationProperties.Name="限流间隔"/>
        </Grid>
        <TextBox x:Name="ProxyMihomoPath" PlaceholderText="mihomo 路径（可留空，使用 PATH）" AutomationProperties.Name="mihomo 路径"/>
        <Button Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Click="ProxySave_Click" AutomationProperties.Name="保存双跳配置"><TextBlock Text="保存配置"/></Button>
       </StackPanel>
      </Border>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
   <Grid Grid.Row="2" Padding="0,13,0,14" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,1,0,0" ColumnSpacing="9">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ProgressRing x:Name="BusyRing" Width="16" Height="16" Visibility="Collapsed"/>
    <TextBlock x:Name="Status" Grid.Column="1" Text="就绪" FontSize="11" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
    <Button Grid.Column="2" x:Name="CancelButton" Content="取消登录" Click="Cancel_Click" Visibility="Collapsed"/>
   </Grid>
  </Grid>
 </Grid>
</Window>
