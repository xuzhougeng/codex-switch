<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
     <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="CanvasBrush" Color="#F7F8FA"/>
      <SolidColorBrush x:Key="SidebarBrush" Color="#EFF2F3"/>
      <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="LineBrush" Color="#E6EBE9"/>
      <SolidColorBrush x:Key="MutedBrush" Color="#677771"/>
      <SolidColorBrush x:Key="BrandBrush" Color="#246B53"/>
      <SolidColorBrush x:Key="TintBrush" Color="#DFEDE5"/>
     </ResourceDictionary>
     <ResourceDictionary x:Key="Default">
      <SolidColorBrush x:Key="CanvasBrush" Color="#171D1B"/>
      <SolidColorBrush x:Key="SidebarBrush" Color="#121815"/>
      <SolidColorBrush x:Key="SurfaceBrush" Color="#202824"/>
      <SolidColorBrush x:Key="LineBrush" Color="#313D36"/>
      <SolidColorBrush x:Key="MutedBrush" Color="#A1B3A9"/>
      <SolidColorBrush x:Key="BrandBrush" Color="#A1DEBC"/>
      <SolidColorBrush x:Key="TintBrush" Color="#293F33"/>
     </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
     <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="10,8"/>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
     <Setter Property="Background" Value="#246B53"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="16,11"/>
    </Style>
   </ResourceDictionary>